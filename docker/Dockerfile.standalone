# Standalone CamusDB server image (single node, no Raft cluster).
#
# Build context MUST be the repository root, e.g.:
#   docker build -f docker/Dockerfile.standalone -t camusdb/camusdb .
# or use docker/publish.sh which wires this up for Docker Hub (camusdb/camusdb).

# Pin the build stage to the NATIVE build platform. Running the .NET SDK under QEMU
# emulation (e.g. building linux/amd64 on an arm64 host) throws MSB4184
# GetTargetPlatformIdentifier('') during MSBuild evaluation. The publish still targets
# the image's architecture: crossgen2 cross-compiles ReadyToRun code for TARGETARCH
# from the native SDK, so no emulation is needed. BuildKit runs this stage once per
# target platform, and each run carries only that RID's native assets (RocksDB, SQLite).
FROM --platform=$BUILDPLATFORM mcr.microsoft.com/dotnet/sdk:10.0 AS build-env

# Set by BuildKit to the architecture of the image being built (amd64, arm64).
ARG TARGETARCH

RUN rm -fr /src && mkdir -p /src
COPY CamusDB.Core /src/CamusDB.Core/
COPY CamusDB.Grpc.Contracts /src/CamusDB.Grpc.Contracts/
COPY CamusDB /src/CamusDB/

# Drop any host-built obj/bin that slipped into the context. A host-restored
# obj/project.assets.json poisons the in-container restore for the target arch
# (MSB4184: GetTargetPlatformIdentifier('') cannot be evaluated). .dockerignore
# alone is not reliable across buildkit versions, so scrub explicitly.
RUN find /src \( -type d -name obj -o -type d -name bin \) -prune -exec rm -rf {} +

# ReadyToRun precompiles the app and its NuGet dependencies to native code, which cuts JIT work on
# the first requests after the server starts. Tiered compilation stays on, so hot methods are still
# recompiled with dynamic PGO and steady-state throughput is unchanged.
RUN case "$TARGETARCH" in \
      amd64) RID=linux-x64 ;; \
      arm64) RID=linux-arm64 ;; \
      *) echo "Unsupported TARGETARCH '$TARGETARCH' (build with BuildKit: amd64 or arm64)" >&2; exit 1 ;; \
    esac \
  && cd /src/CamusDB/ \
  && dotnet publish --configuration Release --runtime "$RID" --no-self-contained \
       -p:PublishReadyToRun=true -p:RunAnalyzers=false -o /app

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app

# HTTP API
EXPOSE 5095

COPY --from=build-env /app .

# Database files live on a volume so data survives container restarts.
RUN mkdir -p /data
VOLUME ["/data"]

ENV DOTNET_SYSTEM_NET_SOCKETS_INLINE_COMPLETIONS=1
ENV CAMUS_HTTP_PORT=5095
ENV CAMUS_DATA_DIR=/data

# Log verbosity is tunable at `docker run` time — no rebuild, no custom appsettings.json.
# Levels are Trace|Debug|Information|Warning|Error|Critical|None (case-insensitive):
#
#   CAMUS_LOG_LEVEL             everything without a more specific rule   (default Information)
#   CAMUS_LOG_LEVEL_KAHUNA      the embedded KV/transaction engine        (default Warning)
#   CAMUS_LOG_LEVEL_KOMMANDER   Raft                                      (default Warning)
#   CAMUS_LOG_LEVEL_GRPC        gRPC server; Information here re-enables the
#                               per-disconnect "Error reading message" traces
#   CAMUS_LOG_FILTERS           any other category, as Category=Level pairs, e.g.
#                               "Microsoft.AspNetCore=Debug,Kahuna.Server.KeyValues=Trace"
#
# e.g. docker run -e CAMUS_LOG_LEVEL=Debug -e CAMUS_LOG_LEVEL_KAHUNA=Debug camusdb/camusdb

# Raft partition count. More partitions spread writes across more WAL queues so concurrent commits
# group-commit into denser fsyncs (higher write throughput). Overridable at `docker run` time.
ENV CAMUS_INITIAL_PARTITIONS=4

ENTRYPOINT ["sh", "-c", "exec dotnet CamusDB.dll \
  --mode=standalone \
  --http-port=${CAMUS_HTTP_PORT:-5095} \
  --data-dir=${CAMUS_DATA_DIR:-/data} \
  --initial-cluster-partitions=${CAMUS_INITIAL_PARTITIONS:-4}"]
