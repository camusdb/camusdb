<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <Version>0.9.5</Version>
    <InvariantGlobalization>true</InvariantGlobalization>
    <NoWarn>$(NoWarn);NU1903</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="App\" />
    <None Remove="App\Controllers\" />
    <None Remove="Library\CommandParser\" />
    <None Remove="Data\" />
    <None Remove="CSharpTest.Net.Collections" />
    <None Remove="App\Models\" />
    <None Remove="Config\" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Data\" />
    <Folder Include="Config\" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets tests reach host-internal types (e.g. the per-stream prepared-statement store) to
         exercise boundaries that are impractical through the public surface alone. -->
    <InternalsVisibleTo Include="CamusDB.Tests" />
  </ItemGroup>
  
  <ItemGroup>
    <ProjectReference Include="..\CamusDB.Core\CamusDB.Core.csproj">
      <GlobalPropertiesToRemove></GlobalPropertiesToRemove>
    </ProjectReference>
    <ProjectReference Include="..\CamusDB.Grpc.Contracts\CamusDB.Grpc.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommandLineParser" Version="2.9.1" />
    <PackageReference Include="Grpc.AspNetCore" Version="2.67.0" />
  </ItemGroup>

  <!-- Opt-in diagnostics exporters. These live only in the host; CamusDB.Core emits via plain
       Meter/ActivitySource and takes no OpenTelemetry dependency. Registered at runtime only for a
       standalone node with diagnostics enabled. -->
  <ItemGroup>
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" Version="1.17.0-beta.1" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.17.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Config\config.yml" CopyToPublishDirectory="PreserveNewest"></Content>
  </ItemGroup>
  
</Project>
