<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <Version>0.10.3</Version>
    <InvariantGlobalization>true</InvariantGlobalization>
    <NoWarn>$(NoWarn);NU1903</NoWarn>
  </PropertyGroup>

  <!-- Ship the server as a .NET global tool: install it with `dotnet tool install`, then run `camusdb`.
       PackAsTool only adds targets under Pack, so `dotnet build`, `dotnet run` against this project
       and the container publish are unaffected. The Web SDK disables packing by default, hence the
       explicit IsPackable. PackageId must be set here rather than passed as a global property on the
       command line, where it would flow to CamusDB.Core and collide in the restore graph. -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>camusdb</ToolCommandName>
    <PackageId>CamusDB.Server</PackageId>
    <PackageOutputPath>$(MSBuildThisFileDirectory)..\artifacts\nupkg</PackageOutputPath>

    <Authors>CamusDB</Authors>
    <Description>CamusDB — a NewSQL relational database server. Install it as a global tool and run `camusdb` to start a standalone node.</Description>
    <PackageTags>database;sql;newsql;server;kv</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageProjectUrl>https://github.com/camusdb/camusdb</PackageProjectUrl>
    <RepositoryUrl>https://github.com/camusdb/camusdb</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <!-- A tool package is installed, never referenced, so a symbols package has no consumer. The
         Web SDK additionally packs wwwroot a second time under staticwebassets/ for referencing
         projects; that is ~5% of the uncompressed package and near zero compressed, and switching it
         off means fighting the SDK's static-asset pipeline, so it is left alone. The size lever that
         matters is per-RID tool packages (ToolPackageRuntimeIdentifiers), which would drop the ~118 MB
         of native RocksDB/SQLite binaries down to the one platform being installed. -->
    <IncludeSymbols>false</IncludeSymbols>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="/" Visible="false" />
    <None Include="../LICENSE.txt" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="App\" />
    <None Remove="App\Controllers\" />
    <None Remove="Library\CommandParser\" />
    <None Remove="Data\" />
    <None Remove="CSharpTest.Net.Collections" />
    <None Remove="App\Models\" />
    <None Remove="Config\" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Data\" />
    <Folder Include="Config\" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets tests reach host-internal types (e.g. the per-stream prepared-statement store) to
         exercise boundaries that are impractical through the public surface alone. -->
    <InternalsVisibleTo Include="CamusDB.Tests" />
  </ItemGroup>
  
  <ItemGroup>
    <ProjectReference Include="..\CamusDB.Core\CamusDB.Core.csproj">
      <GlobalPropertiesToRemove></GlobalPropertiesToRemove>
    </ProjectReference>
    <ProjectReference Include="..\CamusDB.Grpc.Contracts\CamusDB.Grpc.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommandLineParser" Version="2.9.1" />
    <PackageReference Include="Grpc.AspNetCore" Version="2.67.0" />
  </ItemGroup>

  <!-- Opt-in diagnostics exporters. These live only in the host; CamusDB.Core emits via plain
       Meter/ActivitySource and takes no OpenTelemetry dependency. Registered at runtime only for a
       standalone node with diagnostics enabled. -->
  <ItemGroup>
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" Version="1.17.0-beta.1" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.17.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Config\config.yml" CopyToPublishDirectory="PreserveNewest"></Content>
  </ItemGroup>
  
</Project>
