<Project>
  <!-- Test-only extension assemblies. CamusDB.Tests builds them through project references that do
       not reference their output (ReferenceOutputAssembly=false) and copies each DLL into
       extension-fixtures/ under its own output folder. A normal reference would load a fixture into
       the default load context and hide load-context bugs, so the tests reach fixtures only through
       the server's extension loader. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
</Project>
