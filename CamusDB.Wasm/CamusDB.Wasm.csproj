<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

  <!-- The browser playground host: the CamusDB engine running in a browser tab on the default
       single-threaded browser-wasm runtime. Keep WasmEnableThreads off: the multithreaded runtime
       needs COOP/COEP headers, does not run under Node, and crashed in its own timer code in testing.
       The engine builds for this runtime through CamusDB.Core's net10.0-browser target. -->
  <PropertyGroup>
    <TargetFramework>net10.0-browser</TargetFramework>
    <OutputType>Exe</OutputType>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Required by the JSExport source generator. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);NU1903;CS0436</NoWarn>
    <!-- Trimming needs trim-safe dependencies: Nixie annotates the actor constructors it creates
         by reflection (1.3.2), and Kommander and Kahuna serialize their JSON through source-generated
         contexts (Kahuna.Core 1.9.2). It cuts the bundle from about 12 MB to 4.4 MB with brotli.
         A trimmed publish leaves trimmed framework files in obj/, so delete obj/ and bin/ before a
         publish that turns trimming off again. -->
    <PublishTrimmed>true</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CamusDB.Core\CamusDB.Core.csproj" />
  </ItemGroup>

</Project>
