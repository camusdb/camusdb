<Project Sdk="Microsoft.NET.Sdk">

  <!--
    In-process multi-node cluster test suite. Split out of CamusDB.Tests so the heavy real-Raft
    fixtures run in their own process: this keeps accumulated in-process load (ports, thread pool,
    background Raft tasks from 30+ sequential clusters) out of the main unit-test run, where it
    caused load-induced bring-up flakiness. Run this assembly separately / periodically.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <IsPackable>false</IsPackable>
    <Version>0.1.1</Version>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CamusDB.Core\CamusDB.Core.csproj" />
    <ProjectReference Include="..\CamusDB\CamusDB.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The gRPC transport test doubles (call context, stream readers and writers) are shared with
         the main test project rather than duplicated, so the two suites drive the service the same way. -->
    <Compile Include="..\CamusDB.Tests\Grpc\GrpcTestInfrastructure.cs" Link="Grpc\GrpcTestInfrastructure.cs" />
  </ItemGroup>

</Project>
