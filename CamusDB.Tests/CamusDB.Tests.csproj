<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <IsPackable>false</IsPackable>
    <Version>0.1.1</Version>
    <LangVersion>latest</LangVersion>
    <NoWarn>$(NoWarn);NU1903</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="CsvHelper" Version="33.1.0" />
    <PackageReference Include="Grpc.AspNetCore" Version="2.67.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CamusDB.Core\CamusDB.Core.csproj" />
    <ProjectReference Include="..\CamusDB\CamusDB.csproj" />
    <ProjectReference Include="..\CamusDB.Grpc.Client\CamusDB.Grpc.Client.csproj" />
  </ItemGroup>

  <!-- Extension fixtures: built first, never referenced as assemblies. A normal reference would load a
       fixture into the default load context and hide load-context bugs, so each DLL is copied into
       extension-fixtures/<Fixture>/ and the tests load it only through the server's extension loader.
       Each fixture gets its own folder because two fixtures may carry the same dependency. -->
  <ItemGroup>
    <ExtensionFixture Include="..\CamusDB.Tests.Extensions\*\*.csproj" />
    <ProjectReference Include="@(ExtensionFixture)" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <Target Name="CopyExtensionFixtures" AfterTargets="Build">
    <MSBuild Projects="@(ExtensionFixture)" Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="_ExtensionFixtureOutput" />
    </MSBuild>
    <ItemGroup>
      <_ExtensionFixtureFile Include="%(_ExtensionFixtureOutput.RootDir)%(_ExtensionFixtureOutput.Directory)*.dll">
        <FixtureName>%(_ExtensionFixtureOutput.Filename)</FixtureName>
      </_ExtensionFixtureFile>
    </ItemGroup>
    <Copy SourceFiles="@(_ExtensionFixtureFile)" DestinationFolder="$(OutDir)extension-fixtures\%(_ExtensionFixtureFile.FixtureName)" SkipUnchangedFiles="true" />
  </Target>
  
  <ItemGroup>
    <None Remove="BufferPool\" />
    <None Remove="CommandExecutor\" />
    <None Remove="Indexes\" />
    <None Remove="Fixtures\" />
    <None Remove="Serializator\" />
    <None Remove="Utils\" />
    <None Remove="Flux\" />
    <None Remove="Flux\Fixtures\" />
    <None Remove="ObjectIds\" />
    <None Remove="Config\" />
  </ItemGroup>
  
  <ItemGroup>
    <Folder Include="BufferPool\" />
    <Folder Include="Fixtures\" />
    <Folder Include="Serialization\" />
    <Folder Include="Utils\" />
    <Folder Include="Flux\" />
    <Folder Include="Flux\Fixtures\" />
    <Folder Include="ObjectIds\" />
    <Folder Include="Config\" />
  </ItemGroup>
</Project>
