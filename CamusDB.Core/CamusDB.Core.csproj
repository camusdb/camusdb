<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net10.0-browser builds the engine for the single-threaded browser-wasm runtime that the
         CamusDB.Wasm playground host runs on. It resolves Kahuna.Core's browser assembly, which
         has no ASP.NET Core, gRPC transports, RocksDB or SQLite, so the code that needs them sits
         behind CAMUSDB_BROWSER. A project that references this one builds only the target that
         matches its own framework, so the server and the tests still compile net10.0 alone. -->
    <TargetFrameworks>net10.0;net10.0-browser</TargetFrameworks>
    <Version>0.13.3</Version>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- CS0436: the vendored gplex buffer types (QUT.GplexBuffers) are also embedded in
         Kahuna.Core. The generated scanner references CodePageHandling under the unicode
         option, and the compiler correctly prefers our source copy; the clash is benign. -->
    <NoWarn>$(NoWarn);NU1903;CS0436</NoWarn>
  </PropertyGroup>
  <PropertyGroup Condition="$(TargetFramework.EndsWith('-browser'))">
    <DefineConstants>$(DefineConstants);CAMUSDB_BROWSER</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CamusDB.Tests" />
    <InternalsVisibleTo Include="CamusDB.Cluster.Tests" />
    <InternalsVisibleTo Include="CamusDB.MicroBenchmarks" />
    <!-- The API host's response sinks (gRPC value codec) serialize directly from the internal
         ValueSlot pipeline cell so a projected cell never materializes a ColumnValue on its way
         to the wire. ColumnValue remains the public contract for everything else. -->
    <InternalsVisibleTo Include="CamusDB" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Util\Hashes\" />
    <None Remove="CommandsExecutor\Controllers\Indexes\" />
    <None Remove="Journal\Controllers\Reader\" />
    <None Remove="CommandsExecutor\Models\StateMachines\" />
    <None Remove="Machines\" />
    <None Remove="CommandsExecutor\Controllers\Insert\" />
    <None Remove="Flux\Models\" />
    <None Remove="Commands\Executor\" />
    <None Remove="Commands\Executor\Controllers\" />
    <None Remove="Commands\Executor\Models\" />
    <None Remove="Commands\Validator\" />
    <None Remove="Commands\Validator\Validators\" />
    <None Remove="Storage\" />
    <None Remove="Config\" />
    <None Remove="Config\Models\" />
    <None Remove="Statistics\" />
    <None Remove="Statistics\Models\" />
    <None Remove="Util\Time\" />
    <None Remove="Commands\Executor\Controllers\DDL\" />
    <None Remove="Commands\Executor\Controllers\Queries\" />
    <None Remove="Util\Trees\Experimental\" />
    <None Remove="Transactions\" />
    <None Remove="Transactions\Models\" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Util\Hashes\" />
    <Folder Include="Flux\" />
    <Folder Include="Flux\Models\" />
    <Folder Include="Storage\" />
    <Folder Include="Config\" />
    <Folder Include="Config\Models\" />
    <Folder Include="Statistics\" />
    <Folder Include="Statistics\Models\" />
    <Folder Include="Transactions\" />
    <Folder Include="Transactions\Models\" />
  </ItemGroup>

  <ItemGroup Label="SQLParser">
    <YaccFile Include="SQLParser\SQLParser.Language.grammar.y">
      <OutputFile>SQLParser\SQLParser.Parser.Generated.cs</OutputFile>
      <Arguments>/gplex /nolines</Arguments>
    </YaccFile>
    <None Include="SQLParser\SQLParser.Parser.Generated.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>SQLParser\SQLParser.Language.grammar.y</DependentUpon>
    </None>
    <LexFile Include="SQLParser\SQLParser.Language.analyzer.lex">
      <OutputFile>SQLParser\SQLParser.Scanner.Generated.cs</OutputFile>
    </LexFile>
    <None Include="SQLParser\SQLParser.Scanner.Generated.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>SQLParser\SQLParser.Language.analyzer.lex</DependentUpon>
    </None>
  </ItemGroup>
  
  <ItemGroup>
    <PackageReference Include="K4os.Compression.LZ4" Version="1.3.8" />
    <PackageReference Include="Kahuna.Core" Version="1.9.11" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageReference Include="System.IO.Hashing" Version="10.0.12" />
    <PackageReference Include="YaccLexTools" Version="1.2.3" />
    <PackageReference Include="Nito.AsyncEx" Version="5.1.2" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>
</Project>
