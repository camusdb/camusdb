<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AssemblyName>CamusDB.Workload</AssemblyName>
        <RootNamespace>CamusDB.Workload</RootNamespace>
        <InvariantGlobalization>true</InvariantGlobalization>
    </PropertyGroup>

    <!-- External ADO.NET client, consumed from NuGet (not the in-repo CamusDB.Grpc.Client).
         It exposes parameterized commands and per-transaction isolation/mode/locking knobs
         over the multiplexed gRPC BatchExecute transport (Protocol=grpc). -->
    <ItemGroup>
        <PackageReference Include="CamusDB.Client" Version="0.9.7" />
        <PackageReference Include="CommandLineParser" Version="2.9.1" />
    </ItemGroup>

</Project>
